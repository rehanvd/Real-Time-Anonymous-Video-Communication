# Leave these unset to use the shared hosted services on Render.
# To use your own backend (docker compose in the RandomVideoChat repo), uncomment and
# replace localhost with that machine's IP when other devices need to reach it.

# HTTP base URL for the Matching Service REST endpoint
# VITE_MATCHING_SERVICE_URL=http://localhost:8000

# WebSocket base URL for the Matching Service
# VITE_MATCHING_WS_URL=ws://localhost:8000

# WebSocket base URL for the Signalling Service
# VITE_SIGNALLING_WS_URL=ws://localhost:8001

# TURN relay: "local" uses `npm run turn` on the machine serving the page,
# or set a hosted TURN URL plus VITE_TURN_USERNAME / VITE_TURN_CREDENTIAL
# VITE_TURN_URL=local
